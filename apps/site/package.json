{
  "name": "cfb-apex",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dataset:build": "node scripts/build-dataset.mjs",
    "gameday:source-gate": "node scripts/check-gameday-sources.mjs",
    "predataset:check": "node scripts/build-dataset.mjs",
    "predev": "node scripts/build-dataset.mjs",
    "prebuild": "node scripts/build-dataset.mjs",
    "pretest": "node scripts/build-dataset.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "postbuild": "node scripts/fix-font-urls.mjs",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "check:security-floor": "node scripts/check-security-floor.mjs",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/live-data.test.ts tests/ncaaf-scoreboard.test.ts tests/site-helpers.test.ts tests/refresh.test.ts tests/injury-accuracy.test.ts tests/week7.test.ts tests/week8.test.ts tests/week9.test.ts tests/gameday.test.ts",
    "test:integration": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "node --test tests/rendered-html.test.mjs",
    "test:a11y": "node --test tests/a11y.test.mjs",
    "test:visual": "node scripts/verify-visual-artifacts.mjs",
    "test:links": "node --test tests/links.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "lint": "biome lint app components lib worker scripts tests db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/check-migrations.mjs",
    "db:seed": "node --experimental-strip-types scripts/seed-fixtures.ts",
    "sync:data": "node --experimental-strip-types scripts/sync-data.ts",
    "generate:social": "node scripts/generate-social-content.mjs",
    "cf:types": "wrangler types --config wrangler.deploy.jsonc .wrangler/deploy-types.d.ts",
    "deploy:dry-run": "npm run build && wrangler deploy --config wrangler.deploy.jsonc --dry-run",
    "deploy:production": "npm run verify && wrangler deploy --config wrangler.deploy.jsonc",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:integration && npm run test:a11y && npm run test:seo && npm run test:links && npm run test:visual && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.10",
    "parse5": "8.0.1",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "postcss": "8.5.25",
    "next": {
      "sharp": "0.35.5"
    },
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.0"
  },
  "type": "module"
}
