+describe("zero weeks and independently dated previous results", () => {
+  it("accepts Week 0 across the contract and preserves zero search values", () => {
+    const feed = makeFeed();
+    const zero = {...feed,selectedWeek:0,weeks:[{...feed.weeks[0]!,week:0}],games:feed.games.map(g=>({...g,week:0})),previousFinals:[]};
+    expect(gamedayFeedSchema.safeParse(zero).success).toBe(true);
+    expect(selectFeedWeek(gamedayFeedSchema.parse(zero),0)?.week).toBe(0);
+    expect(parseReviewedWeekSearch(0)).toBe(0);
+    expect(parseReviewedWeekSearch("0")).toBe(0);
+    for(const invalid of ["",null,undefined,"8junk",-1]) expect(parseReviewedWeekSearch(invalid)).toBeUndefined();
+  });
+  it("uses the previous archive's review date instead of the current results date", () => {
+    const feed=makeFeed();feed.sourceDates.results="2026-10-24";
+    expect(feedFinalsLabel(feed)).toBe("PREVIOUS RESULTS · VERIFIED OCT 18");
+    feed.sourceDates.previousResults="2026-10-17";
+    expect(feedFinalsLabel(feed)).toBe("PREVIOUS RESULTS · VERIFIED OCT 17");
+  });
+});
