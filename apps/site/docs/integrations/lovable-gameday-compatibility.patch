+export function parseReviewedWeekSearch(value: unknown): number | undefined {
+  const week = typeof value === "number" ? value : typeof value === "string" && /^\d{1,2}$/.test(value) ? Number(value) : NaN;
+  return Number.isInteger(week) && week >= 0 && week <= 53 ? week : undefined;
+}
